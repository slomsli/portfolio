<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>My Portfolio | Home</title>
  <link rel="stylesheet" href="assets/style.css" />
</head>
<body>
<a class="skip" href="#main">Skip to content</a>

<header class="site-header">
  <div class="container navbar">
    <a class="brand" href="index.html">
      <img class="brand-avatar" src="assets/me.jpg" alt="Sulaiman Mohammed Sulaiman Bajabaa" />
      <div class="title">
        <strong>Sulaiman Mohammed Sulaiman Bajabaa</strong>
        <span>Software Development • UTeM</span>
      </div>
    </a>

    <nav class="navlinks" aria-label="Primary">
      <a data-nav href="index.html">Home</a>
      <a data-nav href="about.html">About</a>
      <a data-nav href="academics.html">Academics</a>
      <a data-nav href="projects.html">Projects</a>
      <a data-nav href="gallery.html">Skills</a>
      <a data-nav href="contact.html">Contact</a>
    </nav>

    <div class="actions">
      <button class="pill" onclick="toggleTheme()" aria-label="Toggle theme">
        🌓 <span style="font-size:12px;color:var(--muted)">Theme</span>
      </button>
      <a class="pill" href="assets/resume.pdf" target="_blank" rel="noreferrer">
        ⬇️ <span style="font-size:12px;color:var(--muted)">Resume</span>
      </a>
    </div>
  </div>
</header>

<main id="main" class="container">
  <section class="hero">
    <div class="hero-grid">
      <div>
        <h1>Hi, I’m <span style="background:linear-gradient(90deg,var(--accent),var(--accent2),var(--accent3)); -webkit-background-clip:text; background-clip:text; color:transparent;">Sulaiman Mohammed Sulaiman Bajabaa</span>.</h1>
        <p class="lead">
          I build clean interfaces, reliable systems, and student projects that show real progress.
          This portfolio highlights my academic journey, my best work, and the qualities I bring to a team.
        </p>

        <div class="btnrow">
          <a class="btn-primary" href="projects.html">View Projects</a>
          <a class="btn-ghost" href="contact.html">Contact Me</a>
        </div>

        <div class="tagrow" aria-label="Highlights">
          <span class="tag">UI/UX • HCI principles</span>
          <span class="tag">Java • C++ • Web</span>
          <span class="tag">Databases • SQL</span>
          <span class="tag">Team projects</span>
          <span class="tag">Full-stack development</span>
        </div>
      </div>

      <div class="card">
        <div class="profile">
          <img class="avatar-img" src="assets/me.jpg" alt="Sulaiman Mohammed Sulaiman Bajabaa" />
          <div class="who">
            <strong>Quick Profile</strong>
            <span>Student | UTeM</span>
          </div>
        </div>

        <hr class="sep">

        <div class="grid-2">
          <div class="kpi">
            <strong>6+</strong>
            <span>Portfolio pages</span>
          </div>
          <div class="kpi">
            <strong>10+</strong>
            <span>Works / artifacts</span>
          </div>
          <div class="kpi">
            <strong>3</strong>
            <span>Core skills</span>
          </div>
          <div class="kpi">
            <strong>1</strong>
            <span>Strong story</span>
          </div>
        </div>

        <hr class="sep">

        <p style="margin:0;color:var(--muted);font-size:13px;">
          Explore the site using the navigation bar. Each page focuses on a different part of my portfolio.
        </p>
      </div>
    </div>
  </section>

  <div class="section-title">
    <h2>Featured Work</h2>
    
  </div>

  <section class="grid-3">
    <article class="project" data-tags="web uiux hci">
      <strong>IRAS UI (React)</strong>
      <div class="meta">Dashboard • Forms • Clean layout</div>
      <div class="badges">
        <span class="badge">UI</span><span class="badge">HCI</span><span class="badge">React</span>
      </div>
    </article>

    <article class="project" data-tags="java oop">
      <strong>OOP Java Practice</strong>
      <div class="meta">Classes • Inheritance • Encapsulation</div>
      <div class="badges">
        <span class="badge">Java</span><span class="badge">OOP</span><span class="badge">Clean code</span>
      </div>
    </article>

    <article class="project" data-tags="database sql">
      <strong>Database Design</strong>
      <div class="meta">ERD • Normalization • Queries</div>
      <div class="badges">
        <span class="badge">SQL</span><span class="badge">ERD</span><span class="badge">3NF</span>
      </div>
    </article>
  </section>
</main>

<footer class="footer">
  <div class="container">© <span id="year"></span> Sulaiman Mohammed Sulaiman Bajabaa </div>
</footer>

<div id="toast" class="toast" role="status" aria-live="polite"></div>

<script src="assets/app.js"></script>
<script>
  document.getElementById("year").textContent = new Date().getFullYear();
</script>
</body>
</html>
